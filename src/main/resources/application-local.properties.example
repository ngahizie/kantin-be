# ============================================================
# TEMPLATE config lokal - DATABASE & INTEGRATION
#
# Cara pakai:
#   cp src/main/resources/application-local.properties.example \
#      src/main/resources/application-local.properties
#   Isi nilai bertanda <GANTI_...>
#   Jalankan: ./mvnw spring-boot:run -Dspring-boot.run.profiles=local
#
# application-local.properties sudah di-.gitignore.
# JANGAN commit file application-local.properties (AGENTS.md §10).
# ============================================================

# --- Demo data siswa untuk pencarian lokal ---
kantin.demo.enabled=true

# --- Database: PostgreSQL (docker compose up -d) ---
# `sslmode=disable` eksplisit: DB lokal docker compose tanpa TLS (issue #432).
# Jangan pakai nilai ini di staging/produksi.
spring.datasource.url=jdbc:postgresql://localhost:5432/kantin_db?sslmode=disable
# ROLE RUNTIME — HANYA DML (issue #433). Dibuat otomatis oleh docker compose
# (scripts/peran-db/buat-peran.sql). JANGAN pakai `postgres`/superuser.
spring.datasource.username=kantin_app
spring.datasource.password=<GANTI_DB_APP_PASSWORD>
# ROLE MIGRASI (DDL, pemilik skema) — WAJIB beda dari role runtime.
# Bila dua baris ini dikosongkan, Flyway memakai role runtime; profil `local`
# tetap boleh (dikecualikan penjaga), tetapi staging/produksi TIDAK.
spring.flyway.user=kantin_owner
spring.flyway.password=<GANTI_DB_OWNER_PASSWORD>

# --- SEED DATA DEV (HANYA lokal, TIDAK lagi otomatis) ---
# Dataset dummy untuk FE: katalog, kasir, riwayat transaksi, koreksi saldo,
# stok, laporan, setoran TU, dan pengaturan kartu.
#
# Folder `db/seed` SENGAJA tidak didaftarkan di sini. Seeder itu Flyway
# REPEATABLE migration, jadi dulu dijalankan ulang setiap isinya berubah —
# dan isinya meng-TRUNCATE semua tabel lalu menulis ulang transaksi dengan
# tanggal `current_date - n`. Akibatnya data dev terhapus dan transaksi
# dummy "baru" muncul lagi tiap hari (bahkan dengan jam yang belum terjadi).
#
# Butuh data dev? Jalankan sekali secara manual (lihat README-DEV.md):
#   psql -h localhost -U kantin -d kantin_db \
#        -f src/main/resources/db/seed/R__seed_dev.sql
spring.flyway.locations=classpath:db/migration
# DB dev yang pernah memuat seeder sudah mencatat R__seed_dev.sql di
# flyway_schema_history. Tanpa baris ini Flyway menolak start dengan
# "Detected applied migration not resolved locally".
spring.flyway.ignore-migration-patterns=*:missing
kantin.demo.enabled=true

# --- Endpoint publik (default fail-closed di application.properties) ---
# Aktifkan eksplisit hanya di lokal agar Swagger & metrik mudah diakses.
kantin.metrics.public=true
kantin.openapi.public=true

# --- Redis (docker compose up -d) ---
# WAJIB sama dengan REDIS_PASSWORD di .env (docker-compose memakai --requirepass,
# issue #434). Kosong = NOAUTH saat rate limit/blacklist token dipakai.
spring.data.redis.host=localhost
spring.data.redis.port=6379
spring.data.redis.password=<GANTI_REDIS_PASSWORD>

# --- MinIO (opsional di lokal) ---
# MinIO lokal: docker run -p 9000:9000 -p 9001:9001 minio/minio server /data --console-address ":9001"
minio.url=http://localhost:9000
minio.access-key=<GANTI_MINIO_ACCESS_KEY>
minio.secret-key=<GANTI_MINIO_SECRET_KEY>
minio.bucket-name=kantin
minio.url-final=http://localhost:9000/kantin/

# --- JWT RS256: public key penerbit (base64 X.509 DER) ---
# ⛔ BLOCKING Q1/Q2: minta ke tim admin-be (staf) & mobile-be (ortu).
# Format klaim JWT saat ini HANYA sub/typ/jti/iat/exp (tanpa sekolah_id & role)
# -> verifikasi ulang ke tim admin-be sebelum implementasi filter JWT.
JWT_ADMIN_PUBLIC_KEY=
JWT_MOBILE_PUBLIC_KEY=

# Verifikasi issuer (klaim "iss"). Default true. Set false sementara hanya bila
# token uji belum memuat issuer "skoolia-admin"/"skoolia-mobile".
JWT_VERIFY_ISSUER=true

# --- SHIM LOGIN DEV (HANYA lokal) ---
# kantin-be TIDAK punya login sendiri (ADR-0002); identitas dari JWT admin-be.
# Selama admin-be belum bisa dijalankan di mesin dev (Q1), aktifkan shim ini
# agar FE (kantin-fe) bisa login ke POST /api/v1/auth/login dan FE <-> BE
# teruji end-to-end tanpa menunggu tim lain.
#
# AMAN: default false. Hanya hidup di profil "local" + enabled=true. JANGAN
# aktifkan di staging/production.
kantin.dev-login.enabled=false
kantin.dev-login.issuer=skoolia-admin
kantin.dev-login.ttl-ms=43200000
# Private key RSA base64 PKCS#8 DER — HARUS pasangan jwt.admin-public-key di atas.
# Isi HANYA di application-local.properties (untracked). JANGAN commit (AGENTS.md §10).
kantin.dev-login.private-key=

# --- CORS: origin FE yang diizinkan (dipisah koma, TANPA nilai "*") ---
KANTIN_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Integrasi SKOOLIA (REST internal) ---
SKOOLIA_ADMIN_BE_URL=http://localhost:8081
SKOOLIA_MOBILE_BE_URL=
SKOOLIA_INTERNAL_BE_URL=
SKOOLIA_CALLBACK_BE_URL=

# --- Webhook masuk: HMAC-SHA256 (SECURITY.md §5.1, B34) ---
# Rahasia bersama (shared secret) untuk menandatangani webhook. WAJIB diisi
# sebelum endpoint /api/webhook/** dipakai; bila kosong endpoint menjawab 503.
# JANGAN commit nilai asli — pakai environment di staging/produksi.
KANTIN_WEBHOOK_SECRET=<GANTI_WEBHOOK_SECRET>
# Anti-replay: toleransi jam (detik) untuk X-Webhook-Timestamp.
KANTIN_WEBHOOK_TOLERANCE_SECONDS=300
# Allowlist IP/CIDR pengirim (dipisah koma). Kosong = tidak membatasi.
KANTIN_WEBHOOK_ALLOWED_IPS=
